{
  "openapi": "3.1.1",
  "info": {
    "title": "trabalho-biblioteca | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7045"
    },
    {
      "url": "http://localhost:5044"
    }
  ],
  "paths": {
    "/api/livros": {
      "post": {
        "tags": [
          "Livro"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarLivroRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarLivroRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CriarLivroRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CriarLivroRequest": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "isbn": {
            "type": "string"
          },
          "anoPublicacao": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "autorId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Livro"
    }
  ]
}